@namespace Theatre_TimeLine

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                <MudText Typo="Typo.body1">You are not authorized to view this page.</MudText>
                                <MudButton Variant="Variant.Filled" 
                                           Color="Color.Primary" 
                                           Href="MicrosoftIdentity/Account/SignIn"
                                           Class="mt-3">
                                    Sign In
                                </MudButton>
                            </MudAlert>
                        </MudContainer>
                    </LayoutView>
                </NotAuthorized>
                <Authorizing>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8 d-flex justify-center">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                            <MudText Class="ml-3">Authorizing...</MudText>
                        </MudContainer>
                    </LayoutView>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                        <MudText Typo="Typo.h6">Page Not Found</MudText>
                        <MudText Typo="Typo.body1">Sorry, there's nothing at this address.</MudText>
                    </MudAlert>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
