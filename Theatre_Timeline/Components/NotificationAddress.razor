@namespace Theatre_TimeLine.Components
@using Theatre_TimeLine.Contracts
@using Theatre_TimeLine.Models

@inherits AddressBase

@if (RenderContentOnRight)
{
    <MudTimelineItem Size="Size.Small" Color="GetColor(Address)">
        <ItemOpposite>
            <MudText Color="GetColor(Address)">@Address?.GetDisplayLocation()</MudText>
        </ItemOpposite>
        <ItemContent>
            <MudCard Outlined="true" Class="p-2">
                <MudCardContent>
                    <MudText Color="GetColor(Address)" Class="align-content-center">@Address?.Title</MudText>
                    <MudText Class="align-content-center">@((MarkupString)GetContentText(Address?.Description))</MudText>
                    <MudText Class="align-content-center">@((MarkupString)GetContentText(Address?.Content))</MudText>
                </MudCardContent>

                <CascadingValue Value="Address" IsFixed="true">
                    <CascadingValue Value="OnEditAddress" IsFixed="true">
                        <AddressEditMenuItem />
                    </CascadingValue>
                </CascadingValue>
            </MudCard>
        </ItemContent>
    </MudTimelineItem>
}
else
{
    <MudTimelineItem Size="Size.Small" Color="GetColor(Address)">
        <ItemContent>
            <MudText Color="GetColor(Address)">@Address?.GetDisplayLocation()</MudText>
        </ItemContent>
        <ItemOpposite>
            <MudCard Outlined="true" Class="p-2">
                <MudCardContent>
                    <MudText Color="GetColor(Address)" Class="align-content-center">@Address?.Title</MudText>
                    <MudText Class="align-content-center">@((MarkupString)GetContentText(Address?.Description))</MudText>
                    <MudText Class="align-content-center">@((MarkupString)GetContentText(Address?.Content))</MudText>
                </MudCardContent>

                <CascadingValue Value="Address" IsFixed="true">
                    <CascadingValue Value="OnEditAddress" IsFixed="true">
                        <AddressEditMenuItem />
                    </CascadingValue>
                </CascadingValue>
            </MudCard>
        </ItemOpposite>
    </MudTimelineItem>
}

@code {

}
