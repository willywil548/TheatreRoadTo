@using System.Text.RegularExpressions
@using Theatre_TimeLine.Contracts
@namespace Theatre_TimeLine.Components

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-3 mb-n1" />
            Create New Tenant
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudTextField @bind-Value="_tenantName"
                          Label="Tenant Name"
                          Placeholder="e.g., Drama Academy, Theatre Club"
                          Required="true"
                          RequiredError="Tenant name is required"
                          Validation="@(new Func<string, string?>(ValidateTenantName))"
                          Immediate="true"
                          AutoFocus="true"
                          Variant="Variant.Outlined"
                          HelperText="Enter a unique name for the tenant (2-100 characters)"
                          Counter="100"
                          MaxLength="100"
                          Class="mb-4" />
            <MudTextField @bind-Value="_description"
                          Label="Description"
                          Placeholder="Brief description of what this tenant is for..."
                          Lines="3"
                          Variant="Variant.Outlined"
                          HelperText="Optional description for the tenant"
                          Counter="500"
                          MaxLength="500" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Submit"
                   Disabled="@(!_isValid || string.IsNullOrWhiteSpace(_tenantName))">
            Create Tenant
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly string[] ReservedNames = 
    [
        "admin", "administrator", "system", "default", "demo", "test", 
        "null", "undefined", "root", "tenant", "tenants"
    ];

    private static readonly Regex ValidNamePattern = new(@"^[\w\s\-\.\,\&\'\(\)]+$", RegexOptions.Compiled);

    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public IEnumerable<string> ExistingTenantNames { get; set; } = [];

    private MudForm? _form;
    private bool _isValid;
    private string _tenantName = string.Empty;
    private string _description = string.Empty;

    private string? ValidateTenantName(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "Tenant name is required";
        }

        var trimmedName = name.Trim();

        if (trimmedName.Length < 2)
        {
            return "Tenant name must be at least 2 characters";
        }

        if (trimmedName.Length > 100)
        {
            return "Tenant name cannot exceed 100 characters";
        }

        // Check for valid characters (letters, numbers, spaces, common punctuation)
        if (!ValidNamePattern.IsMatch(trimmedName))
        {
            return "Tenant name contains invalid characters. Use only letters, numbers, spaces, and common punctuation (- . , & ' ( ))";
        }

        // Check for reserved names
        if (ReservedNames.Any(reserved => 
            string.Equals(reserved, trimmedName, StringComparison.OrdinalIgnoreCase)))
        {
            return $"'{trimmedName}' is a reserved name and cannot be used";
        }

        // Check for duplicate names
        if (ExistingTenantNames.Any(existing =>
            string.Equals(existing, trimmedName, StringComparison.OrdinalIgnoreCase)))
        {
            return "A tenant with this name already exists";
        }

        // Check for names that are just whitespace or special chars after trim
        if (string.IsNullOrWhiteSpace(trimmedName.Replace("-", "").Replace(".", "").Replace(",", "")))
        {
            return "Tenant name must contain at least some letters or numbers";
        }

        return null;
    }

    private void Cancel() => MudDialog?.Cancel();

    private void Submit()
    {
        if (_isValid && !string.IsNullOrWhiteSpace(_tenantName))
        {
            var result = new CreateTenantResult
            {
                TenantName = _tenantName.Trim(),
                Description = _description?.Trim() ?? string.Empty
            };
            MudDialog?.Close(DialogResult.Ok(result));
        }
    }

    /// <summary>
    /// Result returned from the dialog when a tenant is created.
    /// </summary>
    public sealed class CreateTenantResult
    {
        public string TenantName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
