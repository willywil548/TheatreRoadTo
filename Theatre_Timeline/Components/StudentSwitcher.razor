@using Theatre_TimeLine.Models
@using Theatre_TimeLine.Services
@inject IAccessTokenService AccessTokenService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider Auth

@* 
    StudentSwitcher Component
    Shows a dropdown for parents/guardians who have multiple students.
    Allows switching between individual students or viewing "All Students" roads.
*@

@if (_isTokenUser && _studentTokens.Count > 0)
{
    <div class="student-switcher">
        @if (_studentTokens.Count == 1)
        {
            @* Single student - just show the name *@
            <MudChip T="string" 
                     Size="Size.Small" 
                     Color="Color.Primary" 
                     Variant="Variant.Outlined"
                     Class="student-chip">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                @_currentStudentName
            </MudChip>
        }
        else
        {
            @* Multiple students - show dropdown *@
            <MudMenu Icon="@Icons.Material.Filled.People" 
                     Color="Color.Primary"
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     Dense="true"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     AriaLabel="Switch student">
                <ActivatorContent>
                    <MudChip T="string" 
                             Size="Size.Small" 
                             Color="Color.Primary" 
                             Variant="Variant.Outlined"
                             Class="student-chip clickable">
                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" />
                        @_currentStudentName
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                    </MudChip>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem OnClick="@(() => SwitchToAllStudents())">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Class="mr-2" />
                            <span>All Students (@_studentTokens.Count)</span>
                            @if (_viewMode == ViewMode.AllStudents)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ml-2" Color="Color.Success" />
                            }
                        </div>
                    </MudMenuItem>
                    <MudDivider />
                    @foreach (var token in _studentTokens)
                    {
                        <MudMenuItem OnClick="@(() => SwitchToStudent(token))">
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-2" />
                                <span>@token.StudentName</span>
                                @if (_viewMode == ViewMode.SingleStudent && _currentTokenId == token.TokenId)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="ml-2" Color="Color.Success" />
                                }
                            </div>
                        </MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        }
    </div>
}

<style>
    .student-switcher {
        display: inline-flex;
        align-items: center;
    }
    
    .student-chip {
        cursor: default;
    }
    
    .student-chip.clickable {
        cursor: pointer;
    }
    
    .student-chip.clickable:hover {
        background-color: rgba(var(--mud-palette-primary-rgb), 0.1);
    }
</style>

@code {
    /// <summary>
    /// Event callback when the student selection changes.
    /// Provides the selected token(s) and view mode.
    /// </summary>
    [Parameter]
    public EventCallback<StudentSelectionChangedEventArgs> OnSelectionChanged { get; set; }

    private enum ViewMode
    {
        SingleStudent,
        AllStudents
    }

    private bool _isTokenUser;
    private List<AccessToken> _studentTokens = new();
    private Guid? _currentTokenId;
    private string _currentStudentName = string.Empty;
    private ViewMode _viewMode = ViewMode.SingleStudent;

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        var user = authState.User;

        _isTokenUser = user.IsTokenAuthenticated();

        if (_isTokenUser)
        {
            var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            _currentTokenId = user.GetTokenId();

            if (!string.IsNullOrEmpty(email))
            {
                // Load all tokens for this email (parent may have multiple students)
                _studentTokens = (await AccessTokenService.GetTokensByEmailAsync(email)).ToList();
            }

            // Set current student name
            var currentToken = _studentTokens.FirstOrDefault(t => t.TokenId == _currentTokenId);
            _currentStudentName = currentToken?.StudentName ?? user.Identity?.Name ?? "Student";
        }
    }

    private void SwitchToStudent(AccessToken token)
    {
        if (token.TokenId == _currentTokenId && _viewMode == ViewMode.SingleStudent)
        {
            return; // Already selected
        }

        _viewMode = ViewMode.SingleStudent;
        _currentTokenId = token.TokenId;
        _currentStudentName = token.StudentName;

        // Navigate to token auth endpoint to switch the cookie
        NavigationManager.NavigateTo($"/api/auth/token/{token.TokenId}", forceLoad: true);
    }

    private async Task SwitchToAllStudents()
    {
        if (_viewMode == ViewMode.AllStudents)
        {
            return; // Already in all students mode
        }

        _viewMode = ViewMode.AllStudents;
        _currentStudentName = $"All Students ({_studentTokens.Count})";

        // Notify parent component about the view change
        if (OnSelectionChanged.HasDelegate)
        {
            await OnSelectionChanged.InvokeAsync(new StudentSelectionChangedEventArgs
            {
                ViewMode = StudentViewMode.AllStudents,
                Tokens = _studentTokens,
                AllAuthorizedRoadIds = _studentTokens
                    .SelectMany(t => t.AuthorizedRoadIds)
                    .Distinct()
                    .ToList()
            });
        }

        StateHasChanged();
    }

    /// <summary>
    /// Gets the current view mode.
    /// </summary>
    public StudentViewMode GetCurrentViewMode() => _viewMode == ViewMode.AllStudents
        ? StudentViewMode.AllStudents
        : StudentViewMode.SingleStudent;

    /// <summary>
    /// Gets all road IDs the user has access to across all students.
    /// </summary>
    public IReadOnlyList<Guid> GetAllAuthorizedRoadIds() => _studentTokens
        .SelectMany(t => t.AuthorizedRoadIds)
        .Distinct()
        .ToList();

    /// <summary>
    /// Gets all student tokens for this user.
    /// </summary>
    public IReadOnlyList<AccessToken> GetAllStudentTokens() => _studentTokens;
}
