@using Theatre_TimeLine.Contracts
@using Theatre_TimeLine.Models
@using Theatre_TimeLine.Services
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@namespace Theatre_TimeLine.Components

@inject ITenantManagerService TenantManagerService
@inject IConfiguration Configuration
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavigationManager

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(IsNewAddress ? Icons.Material.Filled.Add : Icons.Material.Filled.Edit)" Class="mr-3 mb-n1" />
            @(IsNewAddress ? "Create Address" : "Edit Address")
        </MudText>
    </TitleContent>
    <DialogContent>
        <!-- Post Type -->
        <MudSelect @bind-Value="addressType" Label="Post Type?" HelperText="Notification, Video, Social Media">
            @foreach (AddressType item in Enum.GetValues(typeof(AddressType)))
            {
                <MudSelectItem Value="@item">@item.ToDisplayString()</MudSelectItem>
            }
        </MudSelect>

        <!-- Location -->
        <MudDatePicker Label="Date of Event" @bind-Date="Address.Location" Class="mt-3" />
        <MudTimePicker Label="Time of Event" AmPm="true" TimeChanged="OnTimeChange" Time="Address?.Location?.TimeOfDay" Class="mt-3" />

        <!-- Title of Location -->
        <MudTextField @bind-Value="Address.Title" Label="Title" Variant="Variant.Text" Class="mt-3" />

        <!-- Description of Location -->
        <MudTextField @bind-Value="Address.Description" Label="Description" Variant="Variant.Text" Class="mt-3" />

        <!-- Poll -->
        @if (addressType == AddressType.Survey)
        {
            <MudSelect @bind-Value="@pollType" Label="Poll Type:" HelperText="Multiple Choice, Yes or No" Class="mt-3">
                @foreach (PollType pollingType in Enum.GetValues(typeof(PollType)))
                {
                    <MudSelectItem Value="@pollingType">@pollingType.ToDisplayString()</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Label="Question" Variant="Variant.Text" TextChanged="AddQuestionText" Class="mt-3" />
            <div style="display:@showOptions" class="mt-2">
                @foreach (string option in poll.Options)
                {
                    <MudChip T="string" Color="Color.Primary" Class="mr-1">@option</MudChip>
                }
                <div class="d-flex align-center gap-2 mt-2">
                    <MudTextField Label="New Option:" Variant="Variant.Text" @bind-Value="pollOptionText" />
                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddPollOption" Size="Size.Small" />
                </div>
            </div>
        }
        else if (addressType == AddressType.Video)
        {
            <!-- Require a YouTube URL for video posts -->
            <MudTextField @bind-Value="Address.Content" Label="YouTube URL" Variant="Variant.Text" Class="mt-3" />
            <div class="d-flex gap-2 mt-2 align-center">
                <MudButton Variant="Variant.Outlined" OnClick="ValidateVideoAsync" Disabled="@(string.IsNullOrWhiteSpace(Address.Content) || _isValidating)">Validate</MudButton>
                @if (_isValidating)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                @if (_videoValidated == true)
                {
                    <MudText Color="Color.Success">Video validated</MudText>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Address.Content) && !IsValidYouTubeUrl(Address.Content))
            {
                <MudText Color="Color.Error" Class="mt-2">Please enter a valid YouTube URL (youtube.com or youtu.be).</MudText>
            }
            else if (!string.IsNullOrWhiteSpace(_videoValidationError))
            {
                <MudText Color="Color.Error" Class="mt-2">@_videoValidationError</MudText>
            }
            else if (!string.IsNullOrWhiteSpace(_serverHasApiKey) && _serverHasApiKey == "true")
            {
                <MudText Color="Color.Secondary" Class="mt-2">Server-side YouTube validation available — click Validate to check embeddability and age restriction.</MudText>
            }
        }
        else
        {
            <MudTextField @bind-Value="Address.Content" Label="Content" Variant="Variant.Text" Class="mt-3" />
        }

        <MudCheckBox @bind-Value="Address.DelayRelease" Label="Delay Release" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="SaveAddress" Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSave)">Save</MudButton>
        @if (!IsNewAddress)
        {
            <MudButton OnClick="DeleteAddress" Color="Color.Error" Variant="Variant.Outlined">Delete</MudButton>
        }
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Text">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public IAddress Address { get; set; } = new Address();

    [Parameter]
    public IRoadToThere Road { get; set; } = new RoadToThere();

    /// <summary>
    /// Explicitly indicates whether this is a new address being created.
    /// This is more reliable than trying to infer from Address properties.
    /// </summary>
    [Parameter]
    public bool IsNewAddress { get; set; } = true;

    private event EventHandler<AddressType>? AddressTypeChanged;

    private AddressType addressType
    {
        get => Address.AddressType;
        set
        {
            if (Address.AddressType == value)
            {
                return;
            }

            Address.AddressType = value;
            AddressTypeChanged?.Invoke(this, value);
        }
    }

    #region Poll Fields and Properties

    private Poll poll = new Poll();
    private string showOptions => poll != null && poll.PollType == PollType.MultipleChoice ? "" : "none";

    private PollType pollType
    {
        get => poll.PollType;
        set => SetPollType(value);
    }

    private string pollOptionText = string.Empty;

    #endregion

    private string? _youtubeApiKey;
    private string? _videoValidationError;
    private bool? _videoValidated = null;
    private bool _isValidating = false;
    private string? _serverHasApiKey;

    protected override async Task OnInitializedAsync()
    {
        AddressTypeChanged += OnAddressTypeChanged;

        // Ensure poll type is set from the existing poll when editing
        if (Address.TryGetPoll(out Poll existingPoll))
        {
            poll = existingPoll;
        }

        // Read YouTube API key presence flag from server via config endpoint
        // We use a lightweight request to /api/youtube/status
        try
        {
            var client = HttpClientFactory.CreateClient();
            var resp = await client.GetAsync(NavigationManager.BaseUri.TrimEnd('/') + "/api/youtube/status");
            if (resp.IsSuccessStatusCode)
            {
                _serverHasApiKey = await resp.Content.ReadAsStringAsync();
            }
        }
        catch
        {
            _serverHasApiKey = null;
        }

        // Read client-side only API key flag (not the key itself)
        _youtubeApiKey = Configuration["ApiKeys:YouTube"];

        await base.OnInitializedAsync();
    }

    private void SetPollType(PollType pollType)
    {
        if (Address.AddressType != AddressType.Survey)
        {
            return;
        }

        poll.PollType = pollType;
        Address.SetPollType(poll);
        StateHasChanged();
    }

    private void AddQuestionText(string? question)
    {
        if (string.IsNullOrEmpty(question))
        {
            return;
        }

        poll.Question = question;
        Address.SetPollQuestion(poll);
        StateHasChanged();
    }

    private void AddPollOption()
    {
        if (string.IsNullOrEmpty(pollOptionText))
        {
            return;
        }

        poll.Options = poll.Options.Concat(new[] { pollOptionText }).ToList();
        Address.SetPollOptions(poll);
        pollOptionText = string.Empty;
        Address.SetPoll(poll);
        StateHasChanged();
    }

    private async Task ValidateVideoAsync()
    {
        _videoValidationError = null;
        _videoValidated = null;

        if (!IsValidYouTubeUrl(Address?.Content))
        {
            _videoValidationError = "Invalid YouTube URL";
            _videoValidated = false;
            StateHasChanged();
            return;
        }

        var id = ExtractYouTubeId(Address!.Content!);
        if (id == null)
        {
            _videoValidationError = "Could not extract video id";
            _videoValidated = false;
            StateHasChanged();
            return;
        }

        // Prefer server-side validation endpoint
        try
        {
            _isValidating = true;
            StateHasChanged();
            var client = HttpClientFactory.CreateClient();
            var resp = await client.GetAsync($"{NavigationManager.BaseUri.TrimEnd('/')}/api/youtube/validate/{Uri.EscapeDataString(id)}");
            if (resp.IsSuccessStatusCode)
            {
                _videoValidated = true;
                _videoValidationError = null;
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                _videoValidationError = !string.IsNullOrWhiteSpace(body) ? body : "Video validation failed";
                _videoValidated = false;
            }
        }
        catch (Exception ex)
        {
            _videoValidationError = ex.Message;
            _videoValidated = false;
        }
        finally
        {
            _isValidating = false;
            StateHasChanged();
        }
    }

    private async Task SaveAddress()
    {
        // Clear previous validation error
        _videoValidationError = null;

        // If video, ensure validated when server supports validation
        if (Address.AddressType == AddressType.Video)
        {
            if (!IsValidYouTubeUrl(Address.Content))
            {
                _videoValidationError = "Please enter a valid YouTube URL.";
                StateHasChanged();
                return;
            }

            // If server has API key configured, require validation
            if (_serverHasApiKey == "true")
            {
                if (_videoValidated != true)
                {
                    _videoValidationError = "Please validate the video before saving.";
                    StateHasChanged();
                    return;
                }
            }
        }

        List<IAddress> addresses = new List<IAddress>(Road.Addresses);

        // Set the poll content if it is a PollAddress
        if (Address.AddressType == AddressType.Survey)
        {
            AddPollOption();
            Address.SetPoll(poll);
        }

        if (addresses.Any(a => a.Equals(Address)))
        {
            // If the address already exists, remove it first
            addresses.Remove(Address);
        }

        // Save address
        addresses.Add(Address);
        Road.Addresses = addresses.Cast<Address>().ToArray();

        // Save to file
        TenantManagerService.SaveRoad(Road);

        MudDialog?.Close(DialogResult.Ok(true));
    }

    private void DeleteAddress()
    {
        List<IAddress> addresses = new List<IAddress>(Road.Addresses.Where(a => !a.Equals(Address)));
        Road.Addresses = addresses.Cast<Address>().ToArray();

        // Save to file
        TenantManagerService.SaveRoad(Road);

        MudDialog?.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog?.Cancel();
    }

    private void OnTimeChange(TimeSpan? time)
    {
        if (time == null || Address.Location == null)
        {
            return;
        }

        Address.Location = Address.Location.Value.Date.Add(time.Value);
    }

    private void OnAddressTypeChanged(object? sender, AddressType addressType)
    {
        if (addressType == AddressType.Survey)
        {
            if (Address is not PollAddress)
            {
                Address = new PollAddress();
            }

            return;
        }

        if (Address is PollAddress)
        {
            Address = new Address();
        }

        StateHasChanged();
    }

    private bool CanSave
    {
        get
        {
            if (Address == null) return false;
            if (Address.AddressType == AddressType.Video)
            {
                // If server validation available, require _videoValidated true; otherwise just ensure URL looks correct
                if (_serverHasApiKey == "true")
                {
                    return _videoValidated == true;
                }

                return IsValidYouTubeUrl(Address.Content);
            }

            // For other types, always allow save (existing behavior)
            return true;
        }
    }

    private bool IsValidYouTubeUrl(string? url)
    {
        return !string.IsNullOrEmpty(YouTubeUrlParser.ExtractVideoId(url));
    }

    private string? ExtractYouTubeId(string url)
    {
        return YouTubeUrlParser.ExtractVideoId(url);
    }
}
