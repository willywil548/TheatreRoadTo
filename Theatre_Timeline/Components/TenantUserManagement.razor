@using Theatre_TimeLine.Contracts
@using Theatre_TimeLine.Services
@using Theatre_TimeLine.Components
@inject ISecurityGroupService SecurityGroupService
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
}
else if (!_canManage)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        You do not have permission to manage users for this tenant.
    </MudAlert>
}
else
{
    <MudPaper Class="pa-2">
        <MudText Typo="Typo.subtitle1">User Management</MudText>

        @if (_isGlobalAdmin)
        {
            @* Global Admins see both tabs *@
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="mt-2">
                <MudTabPanel Text="Share via Link" Icon="@Icons.Material.Filled.Link">
                    <ExternalAccessManager TenantContainer="@TenantContainer" />
                </MudTabPanel>

                <MudTabPanel Text="Organization Members" Icon="@Icons.Material.Filled.Business">
                    @RenderOrganizationMembersContent()
                </MudTabPanel>
            </MudTabs>
        }
        else
        {
            @* Tenant Managers only see Share via Link (no tabs needed) *@
            <div class="mt-2">
                <ExternalAccessManager TenantContainer="@TenantContainer" />
            </div>
        }
    </MudPaper>
}

@* Render fragment for Organization Members content *@
@code {
    private RenderFragment RenderOrganizationMembersContent() => __builder =>
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true" Class="mb-3">
            <MudText Typo="Typo.body2">
                Add people from your organization who sign in with their work or school account.
            </MudText>
        </MudAlert>

        <MudGrid Class="my-2">
            <MudItem xs="12" sm="6" md="5">
                <MudTextField @bind-Value="_userEmail"
                              Label="Email address"
                              Placeholder="name@organization.com"
                              Dense="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Label="Access level" Dense="true" @bind-Value="_selectedRole">
                    <MudSelectItem T="string" Value="@RoleViewer">Viewer - Can view all roads</MudSelectItem>
                    <MudSelectItem T="string" Value="@RoleAdmin">Admin - Can manage this tenant</MudSelectItem>
                    <MudSelectItem T="string" Value="@RoleRoadAccess">Specific Road - Choose below</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?" Label="Select Road" Dense="true"
                           @bind-Value="_selectedRoadId"
                           Disabled="@IsRoadPickerDisabled">
                    @foreach (var r in TenantContainer.Roads)
                    {
                        <MudSelectItem T="Guid?" Value="@r.RoadId">@r.Title</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="12" md="1" Class="d-flex align-center">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!_isApplyEnabled)"
                           OnClick="InviteOrAdd">
                    Add
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_pendingInvites.Count > 0)
        {
            <MudExpansionPanels Elevation="0" Class="mb-2">
                <MudExpansionPanel Text="@($"Pending ({_pendingInvites.Count})")" IsInitiallyExpanded="true">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                        These invitations are waiting for the recipient to accept or for their account to be set up.
                    </MudText>
                    <MudTable Items="@_pendingInvites" Dense="true">
                        <HeaderContent>
                            <MudTh>Email</MudTh>
                            <MudTh>Access Level</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Email</MudTd>
                            <MudTd>@GetFriendlyRoleName(context.Group)</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                    @context.Status
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => RetryInviteAsync(context))">
                                    Check now
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        <MudExpansionPanels Elevation="0">
            <MudExpansionPanel Text="@($"Admins ({_managerCount})")" IsInitiallyExpanded="@(_managerCount > 0)">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    Admins can manage roads, users, and settings for this tenant.
                </MudText>
                <UserGroupMembers GroupName="@_managerGroup" OnChanged="UpdateCountsAsync" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="@($"Viewers ({_userCount})")" IsInitiallyExpanded="@(_userCount > 0)">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    Viewers can access all roads in this tenant.
                </MudText>
                <UserGroupMembers GroupName="@_userGroup" OnChanged="UpdateCountsAsync" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="Road-Specific Access">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    Grant access to specific roads only. Users will only see the roads they're assigned to.
                </MudText>
                <MudTable Items="@TenantContainer.Roads" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Road</MudTh>
                        <MudTh Style="width: 120px;"></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="road">
                        <MudTd>@road.Title</MudTd>
                        <MudTd>
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.GroupAdd"
                                       OnClick="@(() => EnsureRoadGroup(road.RoadId))">
                                Set up
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudExpansionPanel>
        </MudExpansionPanels>

        @* Advanced section for IT admins - collapsed by default *@
        <MudExpansionPanels Elevation="0" Class="mt-4">
            <MudExpansionPanel Text="Advanced (for IT)" IsInitiallyExpanded="false">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                    Technical details for IT administrators. These are the security group names used in your directory.
                </MudText>
                <MudSimpleTable Dense="true" Hover="true" Style="background: transparent;">
                    <tbody>
                        <tr>
                            <td><MudText Typo="Typo.body2">Admin Group</MudText></td>
                            <td><code>@_managerGroup</code></td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.body2">Viewer Group</MudText></td>
                            <td><code>@_userGroup</code></td>
                        </tr>
                        <tr>
                            <td><MudText Typo="Typo.body2">Global Admins</MudText></td>
                            <td><code>@SecurityGroupNameBuilder.GlobalAdminsGroup</code></td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudExpansionPanel>
        </MudExpansionPanels>
    };
}

@code {
    [Parameter] public required ITenantContainer TenantContainer { get; set; }

    // User-friendly role names (internal values)
    private const string RoleViewer = "Viewer";
    private const string RoleAdmin = "Admin";
    private const string RoleRoadAccess = "RoadAccess";

    private string _managerGroup = string.Empty;
    private string _userGroup = string.Empty;
    private bool _canManage;
    private bool _isGlobalAdmin;
    private bool _isLoading = true;

    private string _userEmail = string.Empty;
    private string _selectedRole = RoleViewer;
    private Guid? _selectedRoadId;

    private int _managerCount;
    private int _userCount;

    private bool IsRoadPickerDisabled => _selectedRole != RoleRoadAccess;

    private bool _isApplyEnabled =>
        !string.IsNullOrWhiteSpace(_userEmail)
        && (_selectedRole != RoleRoadAccess || _selectedRoadId.HasValue);

    private readonly List<PendingInvite> _pendingInvites = new();
    private PeriodicTimer? _invitePollTimer;
    private CancellationTokenSource? _pollCts;

    /// <summary>
    /// Converts internal group names to user-friendly display names.
    /// </summary>
    private string GetFriendlyRoleName(string groupName)
    {
        if (groupName.Contains("Manager", StringComparison.OrdinalIgnoreCase))
            return "Admin";
        if (groupName.Contains("User", StringComparison.OrdinalIgnoreCase) && !groupName.Contains("Road", StringComparison.OrdinalIgnoreCase))
            return "Viewer";
        if (groupName.Contains("Road", StringComparison.OrdinalIgnoreCase))
        {
            // Try to find the road title
            var roadIdStr = groupName.Split('-').LastOrDefault();
            if (Guid.TryParse(roadIdStr, out var roadId))
            {
                var road = TenantContainer.Roads.FirstOrDefault(r => r.RoadId == roadId);
                if (road != null)
                    return $"Road: {road.Title}";
            }
            return "Specific Road";
        }
        return "Member";
    }

    protected override async Task OnInitializedAsync()
    {
        _managerGroup = SecurityGroupNameBuilder.TenantManager(TenantContainer.TenantId);
        _userGroup = SecurityGroupNameBuilder.TenantUser(TenantContainer.TenantId);

        // Get user email first (local operation, no API call)
        var auth = await Auth.GetAuthenticationStateAsync();
        var email = auth.User.FindFirst("preferred_username")?.Value ?? auth.User.Identity?.Name;

        if (string.IsNullOrEmpty(email))
        {
            _canManage = false;
            _isLoading = false;
            return;
        }

        // Run all async operations in parallel for faster loading
        var ensureManagerGroupTask = SecurityGroupService.EnsureGroupAsync(_managerGroup);
        var ensureUserGroupTask = SecurityGroupService.EnsureGroupAsync(_userGroup);
        var isGlobalAdminTask = SecurityGroupService.IsUserInGroupAsync(email, SecurityGroupNameBuilder.GlobalAdminsGroup);
        var isTenantManagerTask = SecurityGroupService.IsUserInGroupAsync(email, _managerGroup);

        // Wait for permission checks and group creation in parallel
        await Task.WhenAll(ensureManagerGroupTask, ensureUserGroupTask, isGlobalAdminTask, isTenantManagerTask);

        // Check results - store global admin status separately
        _isGlobalAdmin = await isGlobalAdminTask;
        _canManage = _isGlobalAdmin || await isTenantManagerTask;

        _isLoading = false;

        // Load counts in background after UI is shown (non-blocking) - only for global admins
        if (_canManage && _isGlobalAdmin)
        {
            _ = UpdateCountsInBackgroundAsync();
        }
    }

    /// <summary>
    /// Updates member counts in the background without blocking the UI.
    /// </summary>
    private async Task UpdateCountsInBackgroundAsync()
    {
        // Run both count queries in parallel
        var managerCountTask = SecurityGroupService.GetGroupMembersAsync(_managerGroup);
        var userCountTask = SecurityGroupService.GetGroupMembersAsync(_userGroup);

        await Task.WhenAll(managerCountTask, userCountTask);

        _managerCount = (await managerCountTask).Count;
        _userCount = (await userCountTask).Count;

        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateCountsAsync()
    {
        // Run both count queries in parallel
        var managerCountTask = SecurityGroupService.GetGroupMembersAsync(_managerGroup);
        var userCountTask = SecurityGroupService.GetGroupMembersAsync(_userGroup);

        await Task.WhenAll(managerCountTask, userCountTask);

        _managerCount = (await managerCountTask).Count;
        _userCount = (await userCountTask).Count;
        StateHasChanged();
    }

    private async Task InviteOrAdd()
    {
        if (!_canManage || string.IsNullOrWhiteSpace(_userEmail)) return;

        string targetGroup = _selectedRole switch
        {
            RoleAdmin => _managerGroup,
            RoleViewer => _userGroup,
            RoleRoadAccess when _selectedRoadId.HasValue => SecurityGroupNameBuilder.TenantRoadUser(TenantContainer.TenantId, _selectedRoadId.Value),
            _ => string.Empty
        };
        if (string.IsNullOrEmpty(targetGroup)) return;

        string friendlyRole = GetFriendlyRoleName(targetGroup);

        try
        {
            await SecurityGroupService.EnsureGroupAsync(targetGroup);
            var user = await SecurityGroupService.InviteUserAsync(_userEmail.Trim(), _userEmail.Trim(), new[] { targetGroup });

            Snackbar.Add($"{user.Email} added as {friendlyRole}", Severity.Success);
            _userEmail = string.Empty; // Clear the input
            await UpdateCountsAsync();
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("could not be resolved", StringComparison.OrdinalIgnoreCase))
        {
            // Track as pending and start polling
            AddPendingInvite(_userEmail.Trim(), targetGroup, "Waiting for acceptance");
            Snackbar.Add($"Invitation sent to {_userEmail}. They'll appear here once they accept.", Severity.Info);
            _userEmail = string.Empty; // Clear the input
            StartInvitePolling();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not add user: {ex.Message}", Severity.Error);
        }
    }

    private void AddPendingInvite(string email, string group, string status)
    {
        if (_pendingInvites.Any(p => p.Email.Equals(email, StringComparison.OrdinalIgnoreCase) && p.Group.Equals(group, StringComparison.OrdinalIgnoreCase)))
            return;

        _pendingInvites.Add(new PendingInvite
        {
            Email = email,
            Group = group,
            Status = status,
            CreatedUtc = DateTime.UtcNow
        });
        StateHasChanged();
    }

    private void StartInvitePolling()
    {
        if (_invitePollTimer != null) return;

        _pollCts = new CancellationTokenSource();
        _invitePollTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        _ = Task.Run(async () =>
        {
            try
            {
                while (await _invitePollTimer.WaitForNextTickAsync(_pollCts.Token))
                {
                    if (_pendingInvites.Count == 0)
                    {
                        StopInvitePolling();
                        break;
                    }

                    foreach (var p in _pendingInvites.ToList())
                    {
                        p.Attempts++;
                        p.Status = "Checking...";
                        var matches = await SecurityGroupService.SearchUsersAsync(p.Email);
                        var found = matches.FirstOrDefault(m =>
                            m.Email.Equals(p.Email, StringComparison.OrdinalIgnoreCase) ||
                            m.DisplayName?.Equals(p.Email, StringComparison.OrdinalIgnoreCase) == true);

                        if (found != null)
                        {
                            // Ensure membership (idempotent)
                            await SecurityGroupService.AddUserToGroupAsync(p.Email, p.Group);
                            _pendingInvites.Remove(p);
                            var friendlyRole = GetFriendlyRoleName(p.Group);
                            Snackbar.Add($"{p.Email} is now a {friendlyRole}", Severity.Success);
                            await UpdateCountsAsync();
                        }
                        else
                        {
                            p.Status = "Waiting for acceptance";
                        }
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { /* ignore */ }
            finally
            {
                StopInvitePolling();
            }
        });
    }

    private void StopInvitePolling()
    {
        _pollCts?.Cancel();
        _invitePollTimer?.Dispose();
        _pollCts?.Dispose();
        _invitePollTimer = null;
        _pollCts = null;
    }

    private async Task RetryInviteAsync(PendingInvite p)
    {
        p.Status = "Checking...";
        StateHasChanged();

        // Force an immediate check
        var matches = await SecurityGroupService.SearchUsersAsync(p.Email);
        var found = matches.FirstOrDefault(m =>
            m.Email.Equals(p.Email, StringComparison.OrdinalIgnoreCase) ||
            m.DisplayName?.Equals(p.Email, StringComparison.OrdinalIgnoreCase) == true);

        if (found != null)
        {
            await SecurityGroupService.AddUserToGroupAsync(p.Email, p.Group);
            _pendingInvites.Remove(p);
            var friendlyRole = GetFriendlyRoleName(p.Group);
            Snackbar.Add($"{p.Email} is now a {friendlyRole}", Severity.Success);
            await UpdateCountsAsync();
        }
        else
        {
            p.Attempts++;
            p.Status = "Waiting for acceptance";
            StateHasChanged();
        }
    }

    private async Task EnsureRoadGroup(Guid roadId)
    {
        var name = SecurityGroupNameBuilder.TenantRoadUser(TenantContainer.TenantId, roadId);
        await SecurityGroupService.EnsureGroupAsync(name);
        var road = TenantContainer.Roads.FirstOrDefault(r => r.RoadId == roadId);
        Snackbar.Add($"Access group ready for '{road?.Title ?? "this road"}'", Severity.Success);
    }

    private sealed class PendingInvite
    {
        public string Email { get; set; } = string.Empty;
        public string Group { get; set; } = string.Empty;
        public string Status { get; set; } = "Pending";
        public int Attempts { get; set; }
        public DateTime CreatedUtc { get; set; }
    }
}