@page "/access/{Token}"
@using Theatre_TimeLine.Services
@using Theatre_TimeLine.Models
@inject IAccessTokenService AccessTokenService
@inject NavigationManager NavigationManager
@inject ILogger<Access> Logger
@attribute [AllowAnonymous]

<PageTitle>Access - Theatre Timeline</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 60vh;">
    <MudPaper Elevation="3" Class="pa-6" Style="width: 100%; max-width: 450px;">
        @if (_isLoading)
        {
            <div class="d-flex flex-column align-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" Class="mt-4">Validating access...</MudText>
            </div>
        }
        else if (_validationResult?.IsValid == true)
        {
            <div class="d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-4">Welcome, @_validationResult.Token?.StudentName!</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    You have access to @_validationResult.Token?.AuthorizedRoadIds.Count road(s).
                </MudText>
                <MudDivider Class="my-3" Style="width: 100%;" />
                <MudText Typo="Typo.body2" Class="mt-2">Redirecting to your content...</MudText>
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" Style="width: 100%;" />
            </div>
        }
        else
        {
            <div class="d-flex flex-column align-center">
                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="mt-4">Access Denied</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2">
                    @(_validationResult?.FailureReason ?? "Invalid or expired access link.")
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-4">
                    If you believe this is an error, please contact your administrator.
                </MudText>
            </div>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public string? Token { get; set; }

    private bool _isLoading = true;
    private AccessTokenValidationResult? _validationResult;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrEmpty(Token))
        {
            _validationResult = AccessTokenValidationResult.Failure("No access token provided");
            _isLoading = false;
            StateHasChanged();
            return;
        }

        try
        {
            // Validate the token
            _validationResult = await AccessTokenService.ValidateTokenAsync(Token);
            _isLoading = false;
            StateHasChanged();

            if (_validationResult.IsValid && _validationResult.Token != null)
            {
                // Brief pause so user sees the welcome message
                await Task.Delay(1500);

                // Redirect to API endpoint which sets the HttpOnly cookie and redirects to the road
                NavigationManager.NavigateTo($"/api/auth/token/{_validationResult.Token.TokenId}", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating access token");
            _validationResult = AccessTokenValidationResult.Failure("An error occurred while validating your access.");
            _isLoading = false;
            StateHasChanged();
        }
    }
}
