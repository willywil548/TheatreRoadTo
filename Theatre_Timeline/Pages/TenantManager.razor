@using System.Security.Claims
@using Theatre_TimeLine.Components
@using Theatre_TimeLine.Contracts
@using Theatre_TimeLine.Models
@using Theatre_TimeLine.Services
@inject ITenantManagerService TenantManagerService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISecurityGroupService SecurityGroupService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IClipboardService ClipboardService
@inject ISendGridEmailService SendGridEmailService
@inject ILogger<TenantManager> Logger
@implements IRoadToThereManager
@implements IAsyncDisposable
@attribute [Authorize]
@page "/TenantManagement/{Tenant?}"

@if (_isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center" Style="min-height: 50vh;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.body1" Class="mt-4">Loading permissions...</MudText>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
        @* Header with Tenant Selector *@
        <MudPaper Elevation="0" Class="pa-4 mb-4">
            <MudGrid>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="Guid?"
                               Label="Select Tenant"
                               Value="_selectedTenantId"
                               ValueChanged="OnTenantSelected"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               Dense="true"
                               Clearable="true">
                        @foreach (var tenant in _authorizedTenants)
                        {
                            <MudSelectItem T="Guid?" Value="@tenant.TenantId">
                                @tenant.TenantName
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="8" Class="d-flex align-center gap-2">
                    @if (_isGlobalAdmin)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="CreateTenant">
                            New Tenant
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (_selectedTenant != null)
        {
            @* Tenant Header Info Card *@
            <MudPaper Elevation="2" Class="pa-4 mb-4">
                <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                    <div>
                        <MudText Typo="Typo.h5">@_selectedTenant.TenantName</MudText>
                        @if (!string.IsNullOrWhiteSpace(_selectedTenant.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedTenant.Description</MudText>
                        }
                        <div class="d-flex align-center gap-1 mt-1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">ID:</MudText>
                            <MudLink Typo="Typo.caption" Href="@($"/RoadToThere/{_selectedTenant.TenantId}")" Target="_blank">
                                @_selectedTenant.TenantId
                            </MudLink>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                           Size="Size.Small"
                                           Title="Copy tenant link"
                                           OnClick="CopyTenantLink" />
                        </div>
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               Href="@($"/RoadToThere/{_selectedTenant.TenantId}")"
                               Target="_blank">
                        Open Tenant
                    </MudButton>
                </div>
            </MudPaper>

            @* Main Tabbed Interface *@
            <MudTabs Elevation="2"
                     Rounded="true"
                     ApplyEffectsToContainer="true"
                     PanelClass="pa-4"
                     @bind-ActivePanelIndex="_activeTabIndex">

                @* Tab 1: Roads Management *@
                <MudTabPanel Text="Roads" Icon="@Icons.Material.Filled.Route" BadgeData="@_selectedTenant.Roads.Count()" BadgeColor="Color.Primary">
                    <MudStack Spacing="3">
                        <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                            <MudText Typo="Typo.h6">Manage Roads</MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="() => CreateRoad(_selectedTenant)">
                                Create Road
                            </MudButton>
                        </div>

                        @if (!_selectedTenant.Roads.Any())
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                No roads created yet. Create your first road to get started.
                            </MudAlert>
                        }
                        else
                        {
                            <MudExpansionPanels MultiExpansion="false">
                                @foreach (var road in _selectedTenant.Roads)
                                {
                                    <MudExpansionPanel MaxHeight="1500">
                                        <TitleContent>
                                            <div class="d-flex flex-wrap align-center gap-2">
                                                <MudIcon Icon="@Icons.Material.Filled.Timeline" Size="Size.Small" />
                                                <MudText Typo="Typo.body1"><strong>@road.Title</strong></MudText>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                    @road.StartTime?.ToString("MMM dd") - @road.EndTime?.ToString("MMM dd, yyyy")
                                                </MudChip>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <RoadConfiguration Road="@road"
                                                               OnSaveRoad="@SaveRoad"
                                                               OnRemoveRoad="@RemoveRoad" />
                                        </ChildContent>
                                    </MudExpansionPanel>
                                }
                            </MudExpansionPanels>
                        }
                    </MudStack>
                </MudTabPanel>

                @* Tab 2: Email *@
                <MudTabPanel Text="Email"
                             Icon="@Icons.Material.Filled.Email"
                             BadgeData="@GetEmailErrorBadgeData()"
                             BadgeColor="Color.Error">
                    <MudStack Spacing="3">
                        <div class="d-flex flex-wrap justify-space-between align-center gap-2">
                            <MudText Typo="Typo.h6">Received Emails</MudText>
                            <div class="d-flex align-center gap-2">
                                <MudSelect T="EmailStatusFilter"
                                           Value="_emailStatusFilter"
                                           ValueChanged="OnEmailStatusFilterChanged"
                                           Label="Filter"
                                           Variant="Variant.Outlined"
                                           Dense="true"
                                           Style="min-width: 160px;">
                                    <MudSelectItem T="EmailStatusFilter" Value="EmailStatusFilter.All">All</MudSelectItem>
                                    <MudSelectItem T="EmailStatusFilter" Value="EmailStatusFilter.Error">Errors</MudSelectItem>
                                    <MudSelectItem T="EmailStatusFilter" Value="EmailStatusFilter.Success">Success</MudSelectItem>
                                </MudSelect>
                            </div>
                        </div>

                        @if (_isEmailsLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Info" />
                        }
                        else if (_tenantEmailItems.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                No new emails.
                            </MudAlert>
                        }
                        else if (_filteredTenantEmailItems.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                No emails match the selected filter.
                            </MudAlert>
                        }
                        else
                        {
                            <MudList T="TenantEmailListItem" Dense="true" Clickable="true">
                                @foreach (var emailItem in _filteredTenantEmailItems)
                                {
                                    <MudListItem T="TenantEmailListItem" Value="emailItem" OnClick="() => OpenEmailDialogAsync(emailItem)">
                                        <MudIcon Icon="@GetStatusIcon(emailItem.Status)" Class="mr-2" Color="@GetStatusColor(emailItem.Status)" />
                                        <div class="w-100 d-flex justify-space-between align-center gap-2">
                                            <div>
                                                <MudText Typo="Typo.body1">@emailItem.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@emailItem.Subtitle</MudText>
                                            </div>
                                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(emailItem.Status)" Variant="Variant.Outlined">
                                                @GetStatusLabel(emailItem.Status)
                                            </MudChip>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudStack>
                </MudTabPanel>

                @* Tab 3: User Management *@
                <MudTabPanel Text="Users" Icon="@Icons.Material.Filled.People">
                    <CascadingAuthenticationState>
                        <TenantUserManagement TenantContainer="@_selectedTenant" />
                    </CascadingAuthenticationState>
                </MudTabPanel>

                @* Tab 4: Tenant Settings *@
                <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings">
                    <MudStack Spacing="4">
                        <MudText Typo="Typo.h6">Tenant Settings</MudText>

                        <MudTextField Value="@_selectedTenant.TenantName"
                                      Label="Tenant Name"
                                      ReadOnly="true"
                                      Variant="Variant.Outlined" />

                        <MudTextField Value="@_selectedTenant.Description"
                                      Label="Description"
                                      ReadOnly="true"
                                      Lines="3"
                                      Variant="Variant.Outlined" />

                        <MudTextField Value="@_selectedTenant.TenantId.ToString()"
                                      Label="Tenant ID"
                                      ReadOnly="true"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                      OnAdornmentClick="CopyTenantId" />

                        <MudDivider Class="my-4" />

                        @* Danger Zone *@
                        <MudPaper Elevation="0" Class="pa-4" Style="border: 2px solid var(--mud-palette-error); border-radius: 4px;">
                            <div class="d-flex align-center gap-2 mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" />
                                <MudText Typo="Typo.subtitle1" Color="Color.Error">Danger Zone</MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="mb-3">
                                Deleting a tenant will permanently remove all roads, user assignments, and data associated with this tenant.
                                <strong>This action cannot be undone.</strong>
                            </MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.DeleteForever"
                                       OnClick="() => ConfirmRemoveTenant(_selectedTenant)">
                                Delete Tenant
                            </MudButton>
                        </MudPaper>
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        }
        else if (_authorizedTenants.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                <MudText>You don't have access to any tenants yet.</MudText>
                @if (_isGlobalAdmin)
                {
                    <MudText Class="mt-2">Use the <strong>New Tenant</strong> button above to create your first tenant.</MudText>
                }
                else
                {
                    <MudText Class="mt-2">Contact a Global Admin to grant you access to a tenant.</MudText>
                }
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                Select a tenant from the dropdown above to manage its roads and users.
            </MudAlert>
        }
    </MudContainer>
}

@code {
    private bool _isLoading = true;
    private bool _isGlobalAdmin = false;
    private string _userEmail = string.Empty;
    private ClaimsPrincipal? _currentUser;
    private List<ITenantContainer> _authorizedTenants = new();
    private ITenantContainer? _selectedTenant;
    private Guid? _selectedTenantId;
    private int _activeTabIndex = 0;

    private enum EmailIngestionStatus
    {
        Success,
        InProgress,
        Error
    }

    private enum EmailStatusFilter
    {
        All,
        InProgress,
        Error,
        Success
    }

    private sealed record TenantEmailListItem(
        StoredEmailSummary Summary,
        string Title,
        string Subtitle,
        string Target,
        EmailIngestionStatus Status,
        string StatusMessage,
        SendGridInboundEmail? Email);

    private List<TenantEmailListItem> _tenantEmailItems = new();
    private List<TenantEmailListItem> _filteredTenantEmailItems = new();
    private EmailStatusFilter _emailStatusFilter = EmailStatusFilter.All;
    private bool _isEmailsLoading;

    [Parameter]
    public string? Tenant { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _currentUser = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _userEmail = _currentUser.GetEmail();

        await LoadPermissionsAsync();

        // Select tenant from URL parameter if provided
        if (!string.IsNullOrEmpty(Tenant) && Guid.TryParse(Tenant, out var tenantId))
        {
            _selectedTenantId = tenantId;
            _selectedTenant = _authorizedTenants.FirstOrDefault(t => t.TenantId == tenantId);
        }
        else if (_authorizedTenants.Count == 1)
        {
            // Auto-select if user only has access to one tenant
            _selectedTenantId = _authorizedTenants[0].TenantId;
            _selectedTenant = _authorizedTenants[0];
        }

        await LoadTenantEmailsAsync();
        SendGridEmailService.InboundEmailIngested += OnInboundEmailIngested;
        _isLoading = false;
    }

    private void OnInboundEmailIngested(object? sender, EmailIngestedEventArgs e)
    {
        if (_selectedTenant is null || e.TenantId != _selectedTenant.TenantId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadTenantEmailsAsync();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Loads all permissions asynchronously to avoid blocking the UI thread.
    /// </summary>
    private async Task LoadPermissionsAsync()
    {
        _isGlobalAdmin = await SecurityGroupService.HasRequiredPerms(
            RequiredSecurityLevel.Global,
            _userEmail,
            Guid.Empty,
            Guid.Empty);

        var allTenants = TenantManagerService.GetTenants();
        var authorizedList = new List<ITenantContainer>();

        foreach (var container in allTenants)
        {
            if (_isGlobalAdmin)
            {
                authorizedList.Add(container);
                continue;
            }

            var canManage = await SecurityGroupService.HasRequiredPerms(
                RequiredSecurityLevel.TenantManager,
                _userEmail,
                container.TenantId,
                Guid.Empty);

            if (canManage)
            {
                authorizedList.Add(container);
            }
        }

        _authorizedTenants = authorizedList;
    }

    private async Task OnTenantSelected(Guid? tenantId)
    {
        _selectedTenantId = tenantId;
        _selectedTenant = tenantId.HasValue
            ? _authorizedTenants.FirstOrDefault(t => t.TenantId == tenantId.Value)
            : null;

        // Update URL without full reload
        if (_selectedTenantId.HasValue)
        {
            NavigationManager.NavigateTo($"/TenantManagement/{_selectedTenantId}", replace: true);
        }
        else
        {
            NavigationManager.NavigateTo("/TenantManagement", replace: true);
        }

        _activeTabIndex = 0; // Reset to Roads tab when switching tenants
        await LoadTenantEmailsAsync();
    }

    private async Task LoadTenantEmailsAsync()
    {
        if (_isEmailsLoading)
        {
            return;
        }

        _tenantEmailItems.Clear();
        _filteredTenantEmailItems.Clear();

        if (_selectedTenant is null || _currentUser is null)
        {
            return;
        }

        _isEmailsLoading = true;
        try
        {
            var result = await SendGridEmailService.TryListStoredEmailsForAccessAsync(_currentUser, _selectedTenant.TenantId);
            if (!result.Allowed)
            {
                return;
            }

            // Build a lookup from stored filename -> latest processing status so each email row
            // reflects the asynchronous AI processing outcome rather than a hardcoded placeholder.
            var processingResult = await SendGridEmailService.TryListProcessingStatusesForAccessAsync(_currentUser, _selectedTenant.TenantId);
            var processingByStoredAs = new Dictionary<string, EmailProcessingStatusSummary>(StringComparer.OrdinalIgnoreCase);
            if (processingResult.Allowed)
            {
                foreach (var status in processingResult.Statuses)
                {
                    if (string.IsNullOrWhiteSpace(status.StoredAs))
                    {
                        continue;
                    }

                    if (!processingByStoredAs.TryGetValue(status.StoredAs, out var existing) ||
                        (status.UpdatedAt ?? DateTime.MinValue) > (existing.UpdatedAt ?? DateTime.MinValue))
                    {
                        processingByStoredAs[status.StoredAs] = status;
                    }
                }
            }

            var sorted = result.Emails.OrderByDescending(e => e.Created).ToList();
            var items = new List<TenantEmailListItem>(sorted.Count);

            foreach (var summary in sorted)
            {
                var getResult = await SendGridEmailService.TryGetStoredEmailForAccessAsync(_currentUser, summary.Filename);
                var email = getResult.Allowed && getResult.EmailResult.Status == StoredEmailLookupStatus.Success
                    ? getResult.EmailResult.Email
                    : null;

                var from = !string.IsNullOrWhiteSpace(email?.GetFromDisplayName())
                    ? email.GetFromDisplayName()!
                    : email?.GetFromEmail() ?? "Unknown";
                var subject = string.IsNullOrWhiteSpace(email?.Subject) ? "(no subject)" : email!.Subject!;
                var target = BuildTargetLabel(email);
                var title = subject;
                var subtitle = $"From {from} • {target} • Received {summary.Created.ToLocalTime():g}";

                var status = EmailIngestionStatus.InProgress;
                var statusMessage = "Ingestion saved. Processing is queued.";

                if (processingByStoredAs.TryGetValue(summary.Filename, out var processingStatus))
                {
                    // Map processing states to UI states so queued/processing are not shown as errors.
                    status = processingStatus.Status.ToLowerInvariant() switch
                    {
                        "completed" => EmailIngestionStatus.Success,
                        "queued" => EmailIngestionStatus.InProgress,
                        "processing" => EmailIngestionStatus.InProgress,
                        "retryable-failure" => EmailIngestionStatus.InProgress,
                        "failed" => EmailIngestionStatus.Error,
                        _ => EmailIngestionStatus.InProgress
                    };

                    statusMessage = $"Processing {processingStatus.Status} (attempt {processingStatus.Attempt}, created {processingStatus.CreatedCount}, dropped {processingStatus.DroppedCount}).";
                }

                items.Add(new TenantEmailListItem(summary, title, subtitle, target, status, statusMessage, email));
            }

            _tenantEmailItems = items;
            ApplyEmailFilter();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load tenant emails for tenant {TenantId}", _selectedTenant.TenantId);
        }
        finally
        {
            _isEmailsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenEmailDialogAsync(TenantEmailListItem emailItem)
    {
        if (_currentUser is null)
        {
            return;
        }

        var email = emailItem.Email;
        if (email is null)
        {
            var result = await SendGridEmailService.TryGetStoredEmailForAccessAsync(_currentUser, emailItem.Summary.Filename);
            if (!result.Allowed || result.EmailResult.Status != StoredEmailLookupStatus.Success || result.EmailResult.Email is null)
            {
                Snackbar.Add("Unable to open email.", Severity.Warning);
                return;
            }

            email = result.EmailResult.Email;
        }

        var parameters = new DialogParameters<TenantEmailViewDialog>
        {
            { x => x.Email, email },
            { x => x.Target, emailItem.Target },
            { x => x.IngestionStatus, emailItem.StatusMessage },
            { x => x.CreatedUtc, emailItem.Summary.Created }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        };

        await DialogService.ShowAsync<TenantEmailViewDialog>("Inbound Email", parameters, options);
    }

    private void OnEmailStatusFilterChanged(EmailStatusFilter filter)
    {
        _emailStatusFilter = filter;
        ApplyEmailFilter();
    }

    private void ApplyEmailFilter()
    {
        _filteredTenantEmailItems = _emailStatusFilter switch
        {
            EmailStatusFilter.InProgress => _tenantEmailItems.Where(e => e.Status == EmailIngestionStatus.InProgress).ToList(),
            EmailStatusFilter.Error => _tenantEmailItems.Where(e => e.Status == EmailIngestionStatus.Error).ToList(),
            EmailStatusFilter.Success => _tenantEmailItems.Where(e => e.Status == EmailIngestionStatus.Success).ToList(),
            _ => _tenantEmailItems.ToList()
        };
    }

    private int GetEmailErrorCount() =>
        _tenantEmailItems.Count(e => e.Status == EmailIngestionStatus.Error);

    private object? GetEmailErrorBadgeData()
    {
        var errorCount = _tenantEmailItems.Count(e => e.Status == EmailIngestionStatus.Error);
        return errorCount > 0 ? errorCount : null;
    }

    private static string GetStatusIcon(EmailIngestionStatus status) =>
        status switch
        {
            EmailIngestionStatus.Success => Icons.Material.Filled.MarkEmailRead,
            EmailIngestionStatus.InProgress => Icons.Material.Filled.Pending,
            _ => Icons.Material.Filled.Error
        };

    private static Color GetStatusColor(EmailIngestionStatus status) =>
        status switch
        {
            EmailIngestionStatus.Success => Color.Success,
            EmailIngestionStatus.InProgress => Color.Info,
            _ => Color.Error
        };

    private static string GetStatusLabel(EmailIngestionStatus status) =>
        status switch
        {
            EmailIngestionStatus.Success => "Success",
            EmailIngestionStatus.InProgress => "In Progress",
            _ => "Error"
        };

    private string BuildTargetLabel(SendGridInboundEmail? email)
    {
        var tenantName = _selectedTenant?.TenantName ?? "Tenant";
        if (email is null)
        {
            return $"{tenantName} • all roads";
        }

        var toEmail = email.GetToEmail();
        if (string.IsNullOrWhiteSpace(toEmail))
        {
            return $"{tenantName} • all roads";
        }

        var atIndex = toEmail.IndexOf('@');
        if (atIndex <= 0)
        {
            return $"{tenantName} • all roads";
        }

        var localPart = toEmail[..atIndex];
        var routeParts = localPart.Split('.', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (routeParts.Length == 2 && Guid.TryParse(routeParts[1], out var roadId))
        {
            var roadTitle = _selectedTenant?.Roads.FirstOrDefault(r => r.RoadId == roadId)?.Title;
            if (!string.IsNullOrWhiteSpace(roadTitle))
            {
                return roadTitle;
            }

            return "Selected road";
        }

        return $"{tenantName} • all roads";
    }

    public void CreateRoad(ITenantContainer tenantContainer)
    {
        var roadToThere = new RoadToThere
        {
            RoadId = Guid.NewGuid(),
            TenantId = tenantContainer.TenantId,
            Title = "New Road",
            StartTime = DateTime.Now,
            EndTime = DateTime.Now.AddDays(30)
        };

        tenantContainer.SaveRoad(roadToThere);
        TenantManagerService.SaveRoad(roadToThere);
        Snackbar.Add("Road created successfully.", Severity.Success);
        StateHasChanged();
    }

    /// <summary>
    /// Save the road to the tenant.
    /// </summary>
    public void SaveRoad(IRoadToThere? roadToThere)
    {
        TenantManagerService.SaveRoad(roadToThere);
        Snackbar.Add("Road saved.", Severity.Success);
        StateHasChanged();
    }

    /// <summary>
    /// Remove the road from the tenant.
    /// </summary>
    public void RemoveRoad(Guid roadId)
    {
        TenantManagerService.RemoveRoad(roadId);
        Snackbar.Add("Road removed.", Severity.Info);
        StateHasChanged();
    }

    /// <inheritdoc />
    public IRoadToThere GetRoad(Guid roadId) => TenantManagerService.GetRoad(roadId);

    private async Task CreateTenant()
    {
        if (!_isGlobalAdmin)
        {
            Snackbar.Add("Only Global Admins can create tenants.", Severity.Warning);
            return;
        }

        var existingNames = TenantManagerService.GetTenants().Select(t => t.TenantName);
        var parameters = new DialogParameters<CreateTenantDialog>
        {
            { x => x.ExistingTenantNames, existingNames }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CreateTenantDialog>("Create New Tenant", parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
        {
            return;
        }

        if (result.Data is CreateTenantDialog.CreateTenantResult tenantResult)
        {
            var newTenant = new TenantContainer
            {
                TenantId = Guid.NewGuid(),
                Description = tenantResult.Description,
                TenantName = tenantResult.TenantName
            };

            TenantManagerService.CreateTenant(newTenant);
            Snackbar.Add($"Tenant '{tenantResult.TenantName}' created successfully.", Severity.Success);

            await LoadPermissionsAsync();

            // Auto-select the newly created tenant
            _selectedTenantId = newTenant.TenantId;
            _selectedTenant = _authorizedTenants.FirstOrDefault(t => t.TenantId == newTenant.TenantId);
            StateHasChanged();
        }
    }

    private async Task ConfirmRemoveTenant(ITenantContainer tenantContainer)
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { x => x.Title, "Confirm Delete" },
            { x => x.Message, $"Are you sure you want to delete the tenant '{tenantContainer.TenantName}'? This will permanently delete all roads and data. This action cannot be undone." },
            { x => x.YesText, "Delete" },
            { x => x.NoText, "Cancel" }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog = await DialogService.ShowAsync<MudMessageBox>("Confirm Delete", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await RemoveTenantAsync(tenantContainer);
        }
    }

    private async Task RemoveTenantAsync(ITenantContainer tenantContainer)
    {
        if (!_isGlobalAdmin && !_authorizedTenants.Any(t => t.TenantId == tenantContainer.TenantId))
        {
            Snackbar.Add("You don't have permission to remove this tenant.", Severity.Warning);
            return;
        }

        TenantManagerService.RemoveTenant(tenantContainer.TenantId);
        Snackbar.Add($"Tenant '{tenantContainer.TenantName}' has been deleted.", Severity.Info);

        _selectedTenant = null;
        _selectedTenantId = null;

        await LoadPermissionsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CopyTenantLink()
    {
        if (_selectedTenant == null) return;

        var fullUrl = NavigationManager.ToAbsoluteUri($"/RoadToThere/{_selectedTenant.TenantId}").ToString();
        await ClipboardService.CopyToClipboard(fullUrl);
        Snackbar.Add("Tenant link copied to clipboard.", Severity.Success);
    }

    private async Task CopyTenantId()
    {
        if (_selectedTenant == null) return;

        await ClipboardService.CopyToClipboard(_selectedTenant.TenantId.ToString());
        Snackbar.Add("Tenant ID copied to clipboard.", Severity.Success);
    }

    public ValueTask DisposeAsync()
    {
        SendGridEmailService.InboundEmailIngested -= OnInboundEmailIngested;
        return ValueTask.CompletedTask;
    }
}

